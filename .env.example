# Secrets for local smoke-tests of api/*.js (never commit real values).
# On Vercel, set all four in Project -> Settings -> Environment Variables.
# All four are required: with any of them missing the matching endpoint
# soft-fails to {ok:false} and the site falls back to EPA AirNow / Open-Meteo.

# https://develop.purpleair.com -> read key
PURPLEAIR_API_KEY=
# The sensor's numeric index. Deliberately has no default in code: an index
# resolves to a street on PurpleAir's public map.
PURPLEAIR_SENSOR_INDEX=

# tempestwx.com -> Settings -> Data Authorizations -> create token
TEMPEST_TOKEN=
# Station id from tempestwx.com/station/<id>. No default in code, same reason.
TEMPEST_STATION_ID=
